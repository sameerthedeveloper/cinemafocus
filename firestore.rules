rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Products: Public read, Admin write
    match /products/{product} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Categories: Public read, Admin write
    match /categories/{category} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Hero Section: Public read, Admin write
    match /hero/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Trust Badges: Public read, Admin write
    match /trust_badges/{badge} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Generic Site Content (Footer, Philosophy, Trust Badges): Public read, Admin write
    match /site_content/{doc} {
       allow read: if true;
       allow write: if request.auth != null;
    }

    // Contact Messages: Public create (everyone can send messages), Admin read/delete
    match /messages/{message} {
      allow create: if true;
      allow read, delete, update: if request.auth != null;
    }

    // Analytics/Stats: Public create/update (everyone can increment stats), Admin read
    match /stats/{stat} {
      allow create, update: if true;
      allow read: if request.auth != null;
    }

    // Admins Collection: Admin read/write
    match /admins/{admin} {
      allow read, write: if request.auth != null;
    }

    // Projects Gallery: Public read, Admin write
    match /projects/{project} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
