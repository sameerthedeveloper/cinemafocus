# Copy to .env.local and fill in. Never commit real values.

# --- Supabase (current production backend) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=
SUPABASE_SERVICE_ROLE_KEY=

# --- Data backend switch ---
# supabase (default) | aws. Unset or any other value = supabase.
DATA_BACKEND=supabase

# --- AWS (used when DATA_BACKEND=aws and by /api/aws/*) ---
# API Gateway HTTP API base URL (serverless output HttpApiUrl), no trailing slash.
API_GATEWAY_URL=
# CloudFront domain for images, host only (e.g. dxxxxxxxx.cloudfront.net).
# CDN_DOMAIN is read server-side; NEXT_PUBLIC_CDN_DOMAIN is exposed to the browser
# and also enables the next/image remotePattern for the CDN host.
CDN_DOMAIN=
NEXT_PUBLIC_CDN_DOMAIN=
# Cognito user pool + app client (serverless outputs). ID tokens are verified.
COGNITO_POOL_ID=
COGNITO_CLIENT_ID=
